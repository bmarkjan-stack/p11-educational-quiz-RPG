    "description": "Learn how relational databases store and query data.",
    "sections": [
        {
            "id": "what-is-a-relational-database",
            "title": "What Is a Relational Database",
            "content": "A relational database stores data in tables made of rows and columns. Each table usually has a primary key that uniquely identifies each row, and foreign keys that link rows in one table to rows in another.",
            "examples": [
                "users(id, name, email)",
                "orders(id, user_id, total)"
            ],
            "quiz": [
                {
                    "question": "How does a relational database organize data?",
                    "choices": [
                        "Into tables made of rows and columns",
                        "Only into text files",
                        "Into images and folders",
                        "Only into JSON objects"
                    ],
                    "answer": 0
                },
                {
                    "question": "What is the purpose of a primary key?",
                    "choices": [
                        "To encrypt a table",
                        "To uniquely identify each row",
                        "To sort all rows",
                        "To delete duplicate rows"
                    ],
                    "answer": 1
                },
                {
                    "question": "What does a foreign key do?",
                    "choices": [
                        "Stores a password",
                        "Uniquely identifies every database",
                        "Links a row to a related row in another table",
                        "Deletes a related table"
                    ],
                    "answer": 2
                }
            ]
        },
        {
            "id": "select-where",
            "title": "Querying with SELECT & WHERE",
            "content": "SELECT retrieves columns from a table. WHERE filters rows based on a condition.",
            "examples": [
                "SELECT name, age FROM users;",
                "SELECT * FROM users WHERE age > 18;"
            ],
            "quiz": [
                {
                    "question": "Which SQL keyword retrieves data from a table?",
                    "choices": [
                        "GET",
                        "SELECT",
                        "FETCH",
                        "PULL"
                    ],
                    "answer": 1
                },
                {
                    "question": "Which clause filters rows based on a condition?",
                    "choices": [
                        "WHERE",
                        "FILTER",
                        "HAVING",
                        "IF"
                    ],
                    "answer": 0
                },
                {
                    "question": "What does `SELECT * FROM users;` retrieve?",
                    "choices": [
                        "Only the first row",
                        "All columns from the users table",
                        "Only the primary key",
                        "Only columns containing text"
                    ],
                    "answer": 1
                }
            ]
        },
        {
            "id": "join-and-aggregations",
            "title": "JOIN & Aggregations",
            "content": "JOIN combines rows from two or more tables using a related column, such as a foreign key. GROUP BY groups rows sharing a value, often used with aggregate functions like COUNT, SUM, and AVG.",
            "examples": [
                "SELECT orders.id, users.name",
                "FROM orders",
                "JOIN users ON orders.user_id = users.id;",
                "SELECT department, COUNT(*)",
                "FROM employees",
                "GROUP BY department;"
            ],
            "quiz": [
                {
                    "question": "What is the purpose of a JOIN?",
                    "choices": [
                        "To combine related rows from two or more tables",
                        "To delete rows from a table",
                        "To create a database backup",
                        "To rename a column"
                    ],
                    "answer": 0
                },
                {
                    "question": "What does GROUP BY do?",
                    "choices": [
                        "Sorts rows alphabetically",
                        "Groups rows that share a value",
                        "Deletes duplicate rows",
                        "Combines two tables"
                    ],
                    "answer": 1
                },
                {
                    "question": "Which aggregate function counts rows?",
                    "choices": [
                        "SUM()",
                        "AVG()",
                        "COUNT()",
                        "TOTAL()"
                    ],
                    "answer": 2
                }
            ]
        }
    ],

{
    "id": "relational-databases",
    "title": "Relational Databases",
    "description": "Learn how relational databases store and query data.",
    "sections": [
        {
            "id": "what-is-a-relational-database",
            "title": "What Is a Relational Database",
            "pages": [
                {
                    "content": "A relational database stores data in tables made of rows and columns. A row is a single record containing related values. A column is a field representing one type of data, such as name or email.",
                    "examples": [
                        "users",
                        "id | name | email",
                        "1  | Ava  | ava@mail.com",
                        "2  | Ben  | ben@mail.com"
                    ]
                },
                {
                    "content": "A primary key uniquely identifies each row in a table, so no two rows share the same value. It is often named id, but it does not have to be.",
                    "examples": [
                        "users(id, name, email)",
                        "PRIMARY KEY: id",
                        "id 1 -> Ava",
                        "id 2 -> Ben"
                    ]
                },
                {
                    "content": "A foreign key links a row to a related row in another table by storing that row's primary key. Foreign keys establish relationships between tables, such as connecting each order to its user.",
                    "examples": [
                        "users(id, name, email)",
                        "orders(id, user_id, total)",
                        "orders.user_id -> users.id"
                    ]
                }
            ],
            "quiz": [
                {
                    "question": "How does a relational database organize data?",
                    "choices": [
                        "Into tables made of rows and columns",
                        "Only into text files",
                        "Into images and folders",
                        "Only into JSON objects"
                    ],
                    "answer": 0
                },
                {
                    "question": "What is the purpose of a primary key?",
                    "choices": [
                        "To encrypt a table",
                        "To uniquely identify each row",
                        "To sort all rows",
                        "To delete duplicate rows"
                    ],
                    "answer": 1
                },
                {
                    "question": "What does a foreign key do?",
                    "choices": [
                        "Stores a password",
                        "Uniquely identifies every database",
                        "Links a row to a related row in another table",
                        "Deletes a related table"
                    ],
                    "answer": 2
                }
            ]
        },
        {
            "id": "select-where",
            "title": "Querying with SELECT & WHERE",
            "pages": [
                {
                    "content": "SELECT retrieves data from a table. List the columns you want after SELECT and the table after FROM. <code>SELECT name, age FROM users;</code> returns only the name and age columns.",
                    "examples": [
                        "SELECT name, age",
                        "FROM users;"
                    ]
                },
                {
                    "content": "The asterisk <code>*</code> means all columns. <code>SELECT * FROM users;</code> retrieves every column from the users table. SQL statements usually end with a semicolon.",
                    "examples": [
                        "SELECT * FROM users;",
                        "SELECT id, name FROM users;"
                    ]
                },
                {
                    "content": "WHERE filters rows based on a condition. Only rows meeting the condition are returned. WHERE does not change or delete data. Here, only users whose age is greater than 18 are returned.",
                    "examples": [
                        "SELECT * FROM users",
                        "WHERE age > 18;"
                    ]
                }
            ],
            "quiz": [
                {
                    "question": "Which SQL keyword retrieves data from a table?",
                    "choices": [
                        "GET",
                        "FETCH",
                        "PULL",
                        "SELECT"
                    ],
                    "answer": 3
                },
                {
                    "question": "Which clause filters rows based on a condition?",
                    "choices": [
                        "WHERE",
                        "FILTER",
                        "ORDER BY",
                        "IF"
                    ],
                    "answer": 0
                },
                {
                    "question": "What does `SELECT * FROM users;` retrieve?",
                    "choices": [
                        "Only the first row",
                        "All columns from the users table",
                        "Only the primary key",
                        "Only columns containing text"
                    ],
                    "answer": 1
                }
            ]
        },
        {
            "id": "join-and-aggregations",
            "title": "JOIN & Aggregations",
            "pages": [
                {
                    "content": "JOIN combines related rows from two or more tables using a related column, such as a foreign key. The ON clause says how rows match.",
                    "examples": [
                        "SELECT orders.id, users.name",
                        "FROM orders",
                        "JOIN users",
                        "ON orders.user_id = users.id;"
                    ]
                },
                {
                    "content": "The condition <code>orders.user_id = users.id</code> connects each order to its user. A plain JOIN is an INNER JOIN: it returns only rows with matching data in both tables. LEFT JOIN also keeps unmatched left-table rows.",
                    "examples": [
                        "SELECT * FROM users",
                        "INNER JOIN orders",
                        "ON orders.user_id = users.id;",
                        "SELECT * FROM users",
                        "LEFT JOIN orders",
                        "ON orders.user_id = users.id;"
                    ]
                },
                {
                    "content": "GROUP BY groups rows that share a value in one or more columns. It is often used with aggregate functions, which calculate one value for each group of rows.",
                    "examples": [
                        "SELECT department, COUNT(*)",
                        "FROM employees",
                        "GROUP BY department;"
                    ]
                },
                {
                    "content": "<code>COUNT()</code> counts rows, <code>SUM()</code> adds numeric values, and <code>AVG()</code> calculates the average of numeric values. These are the standard aggregate functions.",
                    "examples": [
                        "SELECT COUNT(*) FROM users;",
                        "SELECT SUM(total) FROM orders;",
                        "SELECT AVG(total) FROM orders;"
                    ]
                },
                {
                    "content": "Queries combine these ideas. SELECT chooses columns, WHERE filters rows, JOIN connects tables, and GROUP BY with aggregates summarizes results. To combine users and orders, join them on their related IDs.",
                    "examples": [
                        "SELECT * FROM users",
                        "JOIN orders",
                        "ON orders.user_id = users.id;"
                    ]
                }
            ],
            "quiz": [
                {
                    "question": "What is the purpose of a JOIN?",
                    "choices": [
                        "To delete rows from a table",
                        "To create a database backup",
                        "To combine related rows from two or more tables",
                        "To rename a column"
                    ],
                    "answer": 2
                },
                {
                    "question": "What does GROUP BY do?",
                    "choices": [
                        "Sorts rows alphabetically",
                        "Deletes duplicate rows",
                        "Combines two tables",
                        "Groups rows that share a value"
                    ],
                    "answer": 3
                },
                {
                    "question": "Which aggregate function counts rows?",
                    "choices": [
                        "COUNT()",
                        "SUM()",
                        "AVG()",
                        "TOTAL()"
                    ],
                    "answer": 0
                }
            ]
        }
    ],

        {
            "id": "variables",
            "title": "Variables",
            "content": "Variables store values you can use later. Use 'let' for values that can be reassigned, and 'const' for values that cannot be reassigned after initialization.",
            "examples": [
                "let score = 0;",
                "const name = \"Ava\";"
            ],
            "quiz": [
                {
                    "question": "Which keyword declares a variable that cannot be reassigned?",
                    "choices": [
                        "let",
                        "const",
                        "var",
                        "static"
                    ],
                    "answer": 1
                },
                {
                    "question": "Which keyword should you use for a variable whose value will change?",
                    "choices": [
                        "const",
                        "let",
                        "fixed",
                        "static"
                    ],
                    "answer": 1
                },
                {
                    "question": "What value is stored in the variable `score`?",
                    "choices": [
                        "The string \"score\"",
                        "0",
                        "undefined",
                        "true"
                    ],
                    "answer": 1
                }
            ]
        },
        {
            "id": "functions",
            "title": "Functions",
            "content": "Functions are reusable blocks of code. They can take inputs called parameters and return a value. You call a function by using its name followed by parentheses.",
            "examples": [
                "function add(a, b) {",
                "    return a + b;",
                "}"
            ],
            "quiz": [
                {
                    "question": "What is a function in JavaScript?",
                    "choices": [
                        "A reusable block of code",
                        "A type of variable",
                        "A CSS rule",
                        "An HTML element"
                    ],
                    "answer": 0
                },
                {
                    "question": "What are `a` and `b` in `function add(a, b)`?",
                    "choices": [
                        "Arguments",
                        "Parameters",
                        "Variables declared outside the function",
                        "Return values"
                    ],
                    "answer": 1
                },
                {
                    "question": "What does `add(2, 3)` return if the function returns `a + b`?",
                    "choices": [
                        "23",
                        "5",
                        "undefined",
                        "Error"
                    ],
                    "answer": 1
                }
            ]
        },
        {
            "id": "arrays",
            "title": "Arrays",
            "content": "Arrays store ordered lists of values. You can access individual items using an index, and array indexes start at 0.",
            "examples": [
                "const colors = [\"red\", \"green\", \"blue\"];",
                "console.log(colors[0]); // \"red\""
            ],
            "quiz": [
                {
                    "question": "What is an array used for?",
                    "choices": [

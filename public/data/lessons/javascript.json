                        "Defining a CSS style",
                        "Creating a function",
                        "Declaring a constant only"
                    ],
                    "answer": 0
                },
                {
                    "question": "What is the index of the first item in a JavaScript array?",
                    "choices": [
                        "1",
                        "-1",
                        "0",
                        "It depends on the array"
                    ],
                    "answer": 2
                },
                {
                    "question": "What does `colors[0]` return for `[\"red\", \"green\", \"blue\"]`?",
                    "choices": [
                        "\"green\"",
                        "\"blue\"",
                        "\"red\"",
                        "undefined"
                    ],
                    "answer": 2
                }
            ]
        }
    ],

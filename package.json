{
    "name": "learnquest",
    "version": "1.0.0",
    "private": true,
    "description": "A data-driven educational quiz RPG built with Phaser.",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "desktop:dev": "node scripts/dev-electron.mjs",
        "desktop:start": "vite build && electron .",
        "desktop:pack": "vite build && electron-builder --dir",
        "desktop:dist": "vite build && electron-builder"
    },
    "dependencies": {
        "phaser": "^3.90.0"
    },
    "devDependencies": {
        "vite": "^7.0.0"
    },
    "main": "electron/main.cjs",
    "build": {
        "appId": "com.learnquest.game",
        "productName": "LearnQuest",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "asar": true,
        "win": {
            "target": [
                "portable",
                "zip"
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "tar.gz"
            ],
            "category": "Game"
        },
        "mac": {
            "target": [
                "zip"
            ],
            "category": "public.app-category.educational-games"
        }
    }
}
